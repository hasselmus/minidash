{
  "server": {
    "host": "0.0.0.0",
    "port": 8788
  },
  "display": {
    "title": "Climate",
    "refresh_seconds": 20,
    "stale_after_minutes": 12,
    "show_absolute_humidity": true,
    "show_wall_details": true,
    "show_status_strip": true
  },
  "environment": {
    "base_url": "http://127.0.0.1:8787",
    "timeout_ms": 5000
  },
  "sensors": [
    {
      "source": "Sensor 1",
      "label": "Room 1"
    },
    {
      "source": "Sensor 2",
      "label": "Room 2"
    },
    {
      "source": "Sensor 3",
      "label": "Room 3"
    },
    {
      "source": "Sensor 4",
      "label": "Outside"
    }
  ],
  "wall": {
    "enabled": true,
    "source": "Wall sensor",
    "label": "Wall margin",
    "caution_below_c": 3,
    "warning_below_c": 1
  },
  "status": {
    "door": {
      "entity": "Door",
      "field": "open",
      "label": "Door"
    },
    "dehumidifier": {
      "entity": "Dehumidifier",
      "field": "dehumidifying",
      "label": "Dehumidifier"
    }
  },
  "plots": {
    "enabled": true,
    "hours": 24,
    "refresh_seconds": 300,
    "pages": [
      {
        "title": "Absolute humidity",
        "metric": "absolute_humidity",
        "unit": "g/m³",
        "sensors": [
          "Sensor 1",
          "Sensor 2",
          "Sensor 3",
          "Sensor 4"
        ]
      },
      {
        "title": "Temperature",
        "metric": "temperature",
        "unit": "°C",
        "sensors": [
          "Sensor 1",
          "Sensor 2",
          "Sensor 3",
          "Sensor 4"
        ]
      },
      {
        "title": "Relative humidity",
        "metric": "relative_humidity",
        "unit": "%",
        "sensors": [
          "Sensor 1",
          "Sensor 2",
          "Sensor 3",
          "Sensor 4"
        ]
      },
      {
        "title": "CO₂",
        "metric": "co2",
        "unit": "ppm",
        "sensors": [
          "Air sensor"
        ]
      },
      {
        "title": "PM2.5",
        "metric": "pm2_5",
        "unit": "µg/m³",
        "sensors": [
          "Air sensor"
        ],
        "zero_baseline": true
      }
    ]
  }
}
